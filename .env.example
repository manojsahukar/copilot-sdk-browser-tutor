# Copy to .env (never commit) and `set -a; . ./.env; set +a` before `npm start`.
# LOCAL dev reads secrets from these env vars. In AWS, ALL secrets live in one Secrets Manager
# secret (client_id, client_secret, session_secret, origin_verify) referenced by GITHUB_OAUTH_SECRET_ARN;
# no secret is placed in Lambda env vars.

# --- GitHub OAuth app (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
# In AWS, set this instead of the two above; the app reads the secret JSON at runtime:
# GITHUB_OAUTH_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:browser-tutor/github-oauth-XXXXXX

# --- App secrets ---
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS   # openssl rand -hex 32 (encrypts the session cookie)
# ORIGIN_VERIFY=REPLACE_WITH_64_HEX_CHARS  # openssl rand -hex 32; when set, the origin rejects any request
                                           # lacking X-Origin-Verify (CloudFront injects it). Leave empty for local dev.

# --- URLs ---
BASE_URL=http://localhost:8080             # OAuth callback = BASE_URL + /auth/callback
PORT=8080
HOST=127.0.0.1

# --- Cross-site demo "sibling" origin ---
# Locally, run a second listener on another port (a genuinely separate origin for the demos):
SIBLING_PORT=8081
# In production these point at the sibling domain and the shared parent cookie domain:
# SIBLING_HOST=sibling.example.com
# SIBLING_URL=https://sibling.example.com
# COOKIE_DOMAIN=example.com                 # parent shared by both subdomains (cross-site cookie demo)

# --- Optional ---
# ALLOWED_LOGINS=your-github-login          # comma-separated allowlist (empty = anyone can sign in)
# MAX_TURNS_PER_HOUR=30
# COPILOT_MODEL=                            # optional; default = runtime default
# DEV_AUTH_BYPASS=1                         # LOCAL ONLY (localhost); skip OAuth, use this machine's Copilot auth.
                                           # Hard-fails at startup if NODE_ENV=production.
